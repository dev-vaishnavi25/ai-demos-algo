# Required only for the cloud-LLM demos (LangChain.js + Vercel AI SDK -> Gemini).
# The Transformers.js demos run entirely in your browser and need NO key.
#
# Get a free key at https://aistudio.google.com/apikey  (free daily request quota).
# Copy this file to `.env.local`, paste your key, then restart `npm run dev`.
#
# One variable powers both frameworks:
#   - Vercel AI SDK (@ai-sdk/google) reads it automatically.
#   - LangChain (@langchain/google-genai) is passed it explicitly in the route.
GOOGLE_GENERATIVE_AI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
